# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# ── 管理员（仅首次启动、库中尚无用户时生效）────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ── JWT 签名密钥（务必改为随机长字符串）────────────────────
MOYIN_SECRET_KEY=change_this_to_a_random_string

# ── Redis（仅 docker-compose.redis.yml 需要）────────────────
# 使用精简版 docker-compose.yml 时可忽略此项
REDIS_PASSWORD=change_this_redis_password

# ── 可选：宿主机电子书源目录（只读挂载到容器 /library-source）
# macOS / Linux 示例：
# LIBRARY_HOST_PATH=/path/to/your/ebooks
# Windows 示例：
# LIBRARY_HOST_PATH=D:/ebooks

# ── 可选：Token 有效期（小时）──────────────────────────────
# MOYIN_TOKEN_EXPIRE_HOURS=24

# ── 可选：外挂 PostgreSQL（不设则使用 /config 内 SQLite）──
# DATABASE_URL=postgresql://moyin:password@db:5432/moyin

# ── 可选：Google Books API Key（也可在管理后台配置）──────
# GOOGLE_BOOKS_API_KEY=
